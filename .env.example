DISCORD_TOKEN=your_bot_token

DISCORD_CLIENT_ID=1517163246862471249
DISCORD_CLIENT_SECRET=your_discord_client_secret

DISCORD_PROXY_URL=http://localhost:8080
# Optional Docker-only proxy URL, e.g. http://host.docker.internal:10809
DISCORD_PROXY_URL_DOCKER=

POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql://muxivo-discord:replace_with_the_same_long_random_password@localhost:5432/muxivo-discord

LOG_LEVEL=INFO

COMMAND_PREFIX=!
ACTIVITY_ROTATION_ENABLED=true
ACTIVITY_ROTATION_INTERVAL_SECONDS=60
ACTIVITY_ALLOWED_ORIGINS=
ACTIVITY_TOKEN_EXCHANGE_LIMIT_PER_MINUTE=120
SUBSCRIPTION_TIER=free
CREATOR_ALERT_POLL_INTERVAL_SECONDS=180

TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
YOUTUBE_API_KEY=your_youtube_api_key

# Local Muxivo Core. Docker reaches the host API through host.docker.internal.
MUXIVO_CORE_API_URL=http://host.docker.internal:8000
MUXIVO_CORE_INTERNAL_API_KEY=
MUXIVO_CORE_QUEUE_SIZE=500
MUXIVO_CORE_WORKER_COUNT=2
MUXIVO_CORE_REQUEST_TIMEOUT_SECONDS=12
