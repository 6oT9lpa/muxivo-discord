[Unit]
Description=Muxivo Discord Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=muxivo-discord
Group=muxivo-discord
WorkingDirectory=/opt/muxivo-discord
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/opt/muxivo-discord/.env
ExecStart=/opt/muxivo-discord/.venv/bin/python main.py
Restart=always
RestartSec=10
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/opt/muxivo-discord
ReadWritePaths=/opt/muxivo-discord/data /opt/muxivo-discord/logs

[Install]
WantedBy=multi-user.target
